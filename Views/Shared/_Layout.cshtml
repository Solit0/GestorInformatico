@using Microsoft.AspNetCore.Identity
@using GestorInformatico.Models
@inject UserManager<Usuarios> UserManager
@inject SignInManager<Usuarios> SignInManager
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - GestorInformatico</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/GestorInformatico.styles.css" asp-append-version="true"/>
</head>
<body class="bg-light d-flex flex-column min-vh-100">
@if (ViewData["HideNavbar"] as bool? != true && !(ViewContext.RouteData.Values["controller"]?.ToString() == "Auth" && ViewContext.RouteData.Values["action"]?.ToString() == "Login"))
{
<header>
    <nav class="navbar navbar-dark bg-dark shadow-sm">
        <div class="container-fluid px-lg-4 d-flex justify-content-between align-items-center">
            <a class="navbar-brand fw-bold d-flex align-items-center mb-0" href="#">
                <i class="bi bi-pc-display-horizontal text-primary me-2 fs-4"></i>
                <span>Gestor<span class="text-primary">Informático</span></span>
            </a>
            <div class="d-flex align-items-center gap-3">
                @if (SignInManager.IsSignedIn(User))
                {
                    var usuarioActual = await UserManager.GetUserAsync(User);
                    if (usuarioActual != null)
                    {
                        var roles = await UserManager.GetRolesAsync(usuarioActual);
                        var rolNombre = roles.FirstOrDefault() ?? "Usuario";
                        var badgeClass = rolNombre == "Administrador" ? "bg-danger" : "bg-info text-dark";

                        <div class="d-flex align-items-center text-white me-2">
                            <div class="rounded-circle bg-primary bg-opacity-25 border border-primary p-2 d-flex align-items-center justify-content-center me-2" style="width: 38px; height: 38px;">
                                <i class="bi bi-person-fill text-primary fs-5"></i>
                            </div>
                            <div class="d-flex flex-column text-end d-none d-sm-flex">
                                <span class="fw-semibold small text-white lh-1 mb-1">
                                    @(usuarioActual.Nombre ?? usuarioActual.UserName)
                                    <span class="badge @badgeClass ms-1 px-1 py-0 small" style="font-size: 0.65rem;">@rolNombre</span>
                                </span>
                                <span class="text-secondary small font-monospace lh-1" style="font-size: 0.75rem;">
                                    <i class="bi bi-envelope me-1"></i>@usuarioActual.Email
                                </span>
                            </div>
                        </div>
                    }
                }
                <a class="btn btn-sm btn-outline-light px-3" asp-controller="Auth" asp-action="Logout" title="Cerrar Sesión">
                    <i class="bi bi-box-arrow-right me-1"></i><span class="d-none d-sm-inline">Cerrar Sesión</span>
                </a>
            </div>
        </div>
    </nav>
</header>
}

<div class="flex-grow-1">
    <main role="main">
        @RenderBody()
    </main>
</div>

<footer class="border-top bg-white py-3 mt-auto text-muted shadow-sm">
    <div class="container-fluid px-lg-4 d-flex flex-wrap justify-content-between align-items-center">
        <span>&copy; 2026 - <strong>GestorInformático</strong> - Sistema de Soporte y Control Técnico</span>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>