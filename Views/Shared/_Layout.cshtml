<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - GestorInformatico</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/GestorInformatico.styles.css" asp-append-version="true"/>
</head>
<body class="bg-light d-flex flex-column min-vh-100">
@if (ViewData["HideNavbar"] as bool? != true && !(ViewContext.RouteData.Values["controller"]?.ToString() == "Auth" && ViewContext.RouteData.Values["action"]?.ToString() == "Login"))
{
<header>
    <nav class="navbar navbar-dark bg-dark shadow-sm">
        <div class="container-fluid px-lg-4 d-flex justify-content-between align-items-center">
            <a class="navbar-brand fw-bold d-flex align-items-center mb-0" href="#">
                <i class="bi bi-pc-display-horizontal text-primary me-2 fs-4"></i>
                <span>Gestor<span class="text-primary">Informático</span></span>
            </a>
            <div>
                <a class="btn btn-sm btn-primary px-3" asp-controller="Auth" asp-action="Login">
                    <i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión
                </a>
            </div>
        </div>
    </nav>
</header>
}

<div class="flex-grow-1">
    <main role="main">
        @RenderBody()
    </main>
</div>

<footer class="border-top bg-white py-3 mt-auto text-muted shadow-sm">
    <div class="container-fluid px-lg-4 d-flex flex-wrap justify-content-between align-items-center">
        <span>&copy; 2026 - <strong>GestorInformático</strong> - Sistema de Soporte y Control Técnico</span>
        <div>
            <a asp-area="" asp-controller="Tecnico" asp-action="Index" class="text-muted text-decoration-none me-3 small">Técnico</a>
            <a asp-area="" asp-controller="Administrador" asp-action="Index" class="text-muted text-decoration-none small">Administrador</a>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>