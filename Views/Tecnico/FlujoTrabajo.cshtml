@{
    ViewData["Title"] = "Flujo de Trabajo y Estados";
}

<div class="container-fluid py-4 px-md-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Tecnico" asp-action="Index" class="text-decoration-none"><i class="bi bi-house-door me-1"></i>Panel Técnico</a></li>
            <li class="breadcrumb-item active" aria-current="page">Flujo de Trabajo y Seguimiento de Estados</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-kanban text-warning me-2"></i>Flujo de Trabajo y Estados
            </h2>
            <p class="text-muted mb-0">Tablero interactivo para el control del ciclo de vida y estado de las reparaciones.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="Tecnico" asp-action="RecepcionOrdenes" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i>Nueva Orden
            </a>
            <a asp-controller="Tecnico" asp-action="Inventario" class="btn btn-outline-success shadow-sm">
                <i class="bi bi-boxes me-1"></i>Consultar Repuestos
            </a>
        </div>
    </div>

    <!-- Barra de Filtros y Búsqueda -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Buscar por Nº orden, cliente, equipo..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select">
                        <option selected>Todos los técnicos asignados</option>
                        <option>Técnico Principal</option>
                        <option>Roberto Flores</option>
                        <option>Elena Martínez</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select">
                        <option selected>Todas las prioridades</option>
                        <option>Alta / Urgente</option>
                        <option>Normal</option>
                    </select>
                </div>
                <div class="col-md-2 text-md-end">
                    <button class="btn btn-outline-secondary w-100" type="button">
                        <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tablero Kanban de Estados -->
    <div class="row g-3">
        <!-- Columna 1: Pendiente -->
        <div class="col-md-6 col-xl-3">
            <div class="card bg-light border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-secondary text-white py-2 d-flex justify-content-between align-items-center rounded-top">
                    <span class="fw-bold"><i class="bi bi-clock me-1"></i>Pendiente</span>
                    <span class="badge bg-white text-dark rounded-pill">2</span>
                </div>
                <div class="card-body p-2 d-flex flex-column gap-3">
                    <!-- Tarjeta Orden -->
                    <div class="card border-0 shadow-sm rounded-2">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-secondary">#ORD-1025</span>
                                <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>Hoy 18:30</span>
                            </div>
                            <h6 class="fw-bold mb-1 text-dark">María Julia Gómez</h6>
                            <p class="text-muted small mb-2"><i class="bi bi-laptop me-1"></i>Laptop Dell Inspiron 15</p>
                            <p class="small text-secondary mb-3 bg-light p-2 rounded">
                                <strong>Falla:</strong> No da video en pantalla externa y ventilador ruidoso.
                            </p>
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="badge bg-light text-dark border"><i class="bi bi-person me-1"></i>Elena M.</span>
                                <button type="button" class="btn btn-sm btn-outline-warning text-dark" title="Mover a En Reparación">
                                    Iniciar <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm rounded-2">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-secondary">#ORD-1026</span>
                                <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>Hoy 17:10</span>
                            </div>
                            <h6 class="fw-bold mb-1 text-dark">Empresa Soluciones IT</h6>
                            <p class="text-muted small mb-2"><i class="bi bi-printer me-1"></i>Impresora HP LaserJet</p>
                            <p class="small text-secondary mb-3 bg-light p-2 rounded">
                                <strong>Falla:</strong> Atasco constante de papel en bandeja 2.
                            </p>
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="badge bg-light text-dark border"><i class="bi bi-person me-1"></i>Roberto F.</span>
                                <button type="button" class="btn btn-sm btn-outline-warning text-dark" title="Mover a En Reparación">
                                    Iniciar <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna 2: En Reparación -->
        <div class="col-md-6 col-xl-3">
            <div class="card bg-light border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-warning text-dark py-2 d-flex justify-content-between align-items-center rounded-top">
                    <span class="fw-bold"><i class="bi bi-gear-wide-connected me-1"></i>En Reparación</span>
                    <span class="badge bg-dark text-white rounded-pill">2</span>
                </div>
                <div class="card-body p-2 d-flex flex-column gap-3">
                    <!-- Tarjeta Orden -->
                    <div class="card border-0 shadow-sm rounded-2 border-start border-warning border-3">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-warning text-dark">#ORD-1024</span>
                                <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>Ayer 14:15</span>
                            </div>
                            <h6 class="fw-bold mb-1 text-dark">Juan Carlos Pérez</h6>
                            <p class="text-muted small mb-2"><i class="bi bi-pc-display me-1"></i>PC Gamer Asus ROG</p>
                            <p class="small text-secondary mb-2 bg-light p-2 rounded">
                                <strong>Diagnóstico:</strong> Fuente de poder dañada por sobretensión. Reemplazo requerido.
                            </p>
                            <div class="mb-3">
                                <a asp-controller="Tecnico" asp-action="Inventario" class="badge bg-info text-dark text-decoration-none">
                                    <i class="bi bi-box-seam me-1"></i>1 Repuesto asignado
                                </a>
                            </div>
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="badge bg-light text-dark border"><i class="bi bi-person me-1"></i>Técnico Principal</span>
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-danger" title="Marcar No se pudo"><i class="bi bi-x-circle"></i></button>
                                    <button type="button" class="btn btn-outline-success" title="Marcar Reparado"><i class="bi bi-check-lg"></i> Listo</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm rounded-2 border-start border-warning border-3">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-warning text-dark">#ORD-1021</span>
                                <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>15/08/2026</span>
                            </div>
                            <h6 class="fw-bold mb-1 text-dark">María Julia Gómez</h6>
                            <p class="text-muted small mb-2"><i class="bi bi-laptop me-1"></i>Laptop HP Pavilion</p>
                            <p class="small text-secondary mb-2 bg-light p-2 rounded">
                                <strong>Diagnóstico:</strong> Reinstalación de SO y limpieza profunda de disipador térmico.
                            </p>
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="badge bg-light text-dark border"><i class="bi bi-person me-1"></i>Elena M.</span>
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-danger" title="Marcar No se pudo"><i class="bi bi-x-circle"></i></button>
                                    <button type="button" class="btn btn-outline-success" title="Marcar Reparado"><i class="bi bi-check-lg"></i> Listo</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna 3: Reparado -->
        <div class="col-md-6 col-xl-3">
            <div class="card bg-light border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-success text-white py-2 d-flex justify-content-between align-items-center rounded-top">
                    <span class="fw-bold"><i class="bi bi-check-circle me-1"></i>Reparado</span>
                    <span class="badge bg-white text-dark rounded-pill">1</span>
                </div>
                <div class="card-body p-2 d-flex flex-column gap-3">
                    <!-- Tarjeta Orden -->
                    <div class="card border-0 shadow-sm rounded-2 border-start border-success border-3">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-success">#ORD-1023</span>
                                <span class="text-muted small"><i class="bi bi-check2-all text-success me-1"></i>16/08</span>
                            </div>
                            <h6 class="fw-bold mb-1 text-dark">Soluciones IT S.A.</h6>
                            <p class="text-muted small mb-2"><i class="bi bi-laptop me-1"></i>MacBook Pro M1</p>
                            <p class="small text-secondary mb-2 bg-light p-2 rounded">
                                <strong>Solución:</strong> Reemplazo de módulo de batería original y pruebas de estrés OK.
                            </p>
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="badge bg-light text-dark border"><i class="bi bi-person me-1"></i>Roberto F.</span>
                                <button type="button" class="btn btn-sm btn-outline-primary" title="Notificar al cliente / Entregar">
                                    <i class="bi bi-box-arrow-up-right me-1"></i>Entregar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Columna 4: No se pudo -->
        <div class="col-md-6 col-xl-3">
            <div class="card bg-light border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-danger text-white py-2 d-flex justify-content-between align-items-center rounded-top">
                    <span class="fw-bold"><i class="bi bi-x-circle me-1"></i>No se pudo</span>
                    <span class="badge bg-white text-dark rounded-pill">1</span>
                </div>
                <div class="card-body p-2 d-flex flex-column gap-3">
                    <!-- Tarjeta Orden -->
                    <div class="card border-0 shadow-sm rounded-2 border-start border-danger border-3">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-danger">#ORD-1019</span>
                                <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>14/08</span>
                            </div>
                            <h6 class="fw-bold mb-1 text-dark">Carlos Rivera</h6>
                            <p class="text-muted small mb-2"><i class="bi bi-motherboard me-1"></i>Tarjeta Madre X570</p>
                            <p class="small text-secondary mb-2 bg-light p-2 rounded">
                                <strong>Motivo:</strong> Cortocircuito severo en capas internas del PCB. Daño irreparable.
                            </p>
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <span class="badge bg-light text-dark border"><i class="bi bi-person me-1"></i>Técnico Principal</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" title="Cerrar y Devolver">
                                    <i class="bi bi-archive me-1"></i>Devolver
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
