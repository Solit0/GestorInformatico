@model GestorInformatico.Models.ViewModels.FlujoTrabajo.FlujoVM
@{
    ViewData["Title"] = "Flujo de Trabajo y Estados";
}

<div class="container-fluid py-4 px-md-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Tecnico" asp-action="Index" class="text-decoration-none"><i class="bi bi-house-door me-1"></i>Panel Técnico</a></li>
            <li class="breadcrumb-item active" aria-current="page">Flujo de Trabajo y Seguimiento de Estados</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-kanban text-warning me-2"></i>Flujo de Trabajo y Estados
            </h2>
            <p class="text-muted mb-0">Tablero interactivo para el control del ciclo de vida y estado de las reparaciones.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="Tecnico" asp-action="RecepcionOrdenes" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i>Nueva Orden
            </a>
            <a asp-controller="Tecnico" asp-action="Inventario" class="btn btn-outline-success shadow-sm">
                <i class="bi bi-boxes me-1"></i>Consultar Repuestos
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Barra de Filtros y Búsqueda -->
    <form method="get" asp-controller="Tecnico" asp-action="FlujoTrabajo" class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="terminoBusqueda" value="@Model.TerminoBusqueda" class="form-control" placeholder="Buscar por Nº orden, cliente, equipo..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="tecnicoSeleccionado" class="form-select" onchange="this.form.submit()">
                        <option value="">Todos los técnicos asignados</option>
                        @if (Model.ListaTecnicos != null)
                        {
                            @foreach (var tecnico in Model.ListaTecnicos)
                            {
                                <option value="@tecnico.Value" selected="@tecnico.Selected">@tecnico.Text</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3 text-md-end">
                    <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-search me-1"></i>Buscar</button>
                    <a asp-controller="Tecnico" asp-action="FlujoTrabajo" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-clockwise me-1"></i>Actualizar</a>
                </div>
            </div>
        </div>
    </form>

    <!-- Tablero Kanban de Estados -->
    <div class="row g-3">
        <!-- Columna 1: Pendiente -->
        <div class="col-md-6 col-xl-3">
            <div class="card bg-light border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-secondary text-white py-2 d-flex justify-content-between align-items-center rounded-top">
                    <span class="fw-bold"><i class="bi bi-clock me-1"></i>Pendiente</span>
                    <span class="badge bg-white text-dark rounded-pill">@Model.TotalPendientes</span>
                </div>
                <div class="card-body p-2 d-flex flex-column gap-3">
                    @if (!Model.OrdenesPendientes.Any())
                    {
                        <div class="text-center text-muted py-3">
                            <i class="bi bi-inbox fs-4 d-block mb-1"></i>
                            <small>Sin órdenes pendientes</small>
                        </div>
                    }
                    else
                    {
                        @foreach (var orden in Model.OrdenesPendientes)
                        {
                            <div class="card border-0 shadow-sm rounded-2">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="badge bg-secondary">@orden.IdFormateado</span>
                                        <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>@orden.FechaFormateada</span>
                                    </div>
                                    <h6 class="fw-bold mb-1 text-dark">@orden.NombreCliente</h6>
                                    <p class="text-muted small mb-2"><i class="bi bi-laptop me-1"></i>@orden.NombreEquipo</p>
                                    <p class="small text-secondary mb-3 bg-light p-2 rounded">
                                        <strong>@orden.EtiquetaDescripcion</strong> @orden.Descripcion
                                    </p>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                        <span class="badge bg-light text-dark border"><i class="bi bi-person me-1"></i>@orden.NombreTecnico</span>
                                        <form asp-controller="Tecnico" asp-action="CambiarEstadoOrden" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@orden.Id" />
                                            <input type="hidden" name="nuevoEstado" value="En reparacion" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning text-dark" title="Mover a En Reparación">
                                                Iniciar <i class="bi bi-arrow-right"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Columna 2: En Reparación -->
        <div class="col-md-6 col-xl-3">
            <div class="card bg-light border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-warning text-dark py-2 d-flex justify-content-between align-items-center rounded-top">
                    <span class="fw-bold"><i class="bi bi-gear-wide-connected me-1"></i>En Reparación</span>
                    <span class="badge bg-dark text-white rounded-pill">@Model.TotalEnReparacion</span>
                </div>
                <div class="card-body p-2 d-flex flex-column gap-3">
                    @if (!Model.OrdenesEnReparacion.Any())
                    {
                        <div class="text-center text-muted py-3">
                            <i class="bi bi-inbox fs-4 d-block mb-1"></i>
                            <small>Sin órdenes en reparación</small>
                        </div>
                    }
                    else
                    {
                        @foreach (var orden in Model.OrdenesEnReparacion)
                        {
                            <div class="card border-0 shadow-sm rounded-2 border-start border-warning border-3">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="badge bg-warning text-dark">@orden.IdFormateado</span>
                                        <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>@orden.FechaFormateada</span>
                                    </div>
                                    <h6 class="fw-bold mb-1 text-dark">@orden.NombreCliente</h6>
                                    <p class="text-muted small mb-2"><i class="bi bi-laptop me-1"></i>@orden.NombreEquipo</p>
                                    <p class="small text-secondary mb-2 bg-light p-2 rounded">
                                        <strong>@orden.EtiquetaDescripcion</strong> @orden.Descripcion
                                    </p>
                                    @if (orden.CantidadRepuestos > 0)
                                    {
                                        <div class="mb-3">
                                            <a asp-controller="Tecnico" asp-action="Inventario" class="badge bg-info text-dark text-decoration-none">
                                                <i class="bi bi-box-seam me-1"></i>@orden.TextoBadgeRepuestos
                                            </a>
                                        </div>
                                    }
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                        <span class="badge bg-light text-dark border"><i class="bi bi-person me-1"></i>@orden.NombreTecnico</span>
                                        <div class="btn-group btn-group-sm">
                                            <form asp-controller="Tecnico" asp-action="CambiarEstadoOrden" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@orden.Id" />
                                                <input type="hidden" name="nuevoEstado" value="No se pudo" />
                                                <button type="submit" class="btn btn-outline-danger" title="Marcar No se pudo"><i class="bi bi-x-circle"></i></button>
                                            </form>
                                            <form asp-controller="Tecnico" asp-action="CambiarEstadoOrden" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@orden.Id" />
                                                <input type="hidden" name="nuevoEstado" value="Reparado" />
                                                <button type="submit" class="btn btn-outline-success" title="Marcar Reparado"><i class="bi bi-check-lg"></i> Listo</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Columna 3: Reparado -->
        <div class="col-md-6 col-xl-3">
            <div class="card bg-light border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-success text-white py-2 d-flex justify-content-between align-items-center rounded-top">
                    <span class="fw-bold"><i class="bi bi-check-circle me-1"></i>Reparado</span>
                    <span class="badge bg-white text-dark rounded-pill">@Model.TotalReparadas</span>
                </div>
                <div class="card-body p-2 d-flex flex-column gap-3">
                    @if (!Model.OrdenesReparadas.Any())
                    {
                        <div class="text-center text-muted py-3">
                            <i class="bi bi-inbox fs-4 d-block mb-1"></i>
                            <small>Sin órdenes reparadas</small>
                        </div>
                    }
                    else
                    {
                        @foreach (var orden in Model.OrdenesReparadas)
                        {
                            <div class="card border-0 shadow-sm rounded-2 border-start border-success border-3">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="badge bg-success">@orden.IdFormateado</span>
                                        <span class="text-muted small"><i class="bi bi-check2-all text-success me-1"></i>@orden.FechaFormateada</span>
                                    </div>
                                    <h6 class="fw-bold mb-1 text-dark">@orden.NombreCliente</h6>
                                    <p class="text-muted small mb-2"><i class="bi bi-laptop me-1"></i>@orden.NombreEquipo</p>
                                    <p class="small text-secondary mb-2 bg-light p-2 rounded">
                                        <strong>@orden.EtiquetaDescripcion</strong> @orden.Descripcion
                                    </p>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                        <span class="badge bg-light text-dark border"><i class="bi bi-person me-1"></i>@orden.NombreTecnico</span>
                                        <span class="btn btn-sm btn-outline-primary disabled" title="Entregado">
                                            <i class="bi bi-box-arrow-up-right me-1"></i>Entregado
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Columna 4: No se pudo -->
        <div class="col-md-6 col-xl-3">
            <div class="card bg-light border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-danger text-white py-2 d-flex justify-content-between align-items-center rounded-top">
                    <span class="fw-bold"><i class="bi bi-x-circle me-1"></i>No se pudo</span>
                    <span class="badge bg-white text-dark rounded-pill">@Model.TotalNoSePudo</span>
                </div>
                <div class="card-body p-2 d-flex flex-column gap-3">
                    @if (!Model.OrdenesNoSePudo.Any())
                    {
                        <div class="text-center text-muted py-3">
                            <i class="bi bi-inbox fs-4 d-block mb-1"></i>
                            <small>Sin órdenes fallidas</small>
                        </div>
                    }
                    else
                    {
                        @foreach (var orden in Model.OrdenesNoSePudo)
                        {
                            <div class="card border-0 shadow-sm rounded-2 border-start border-danger border-3">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="badge bg-danger">@orden.IdFormateado</span>
                                        <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>@orden.FechaFormateada</span>
                                    </div>
                                    <h6 class="fw-bold mb-1 text-dark">@orden.NombreCliente</h6>
                                    <p class="text-muted small mb-2"><i class="bi bi-laptop me-1"></i>@orden.NombreEquipo</p>
                                    <p class="small text-secondary mb-2 bg-light p-2 rounded">
                                        <strong>@orden.EtiquetaDescripcion</strong> @orden.Descripcion
                                    </p>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                        <span class="badge bg-light text-dark border"><i class="bi bi-person me-1"></i>@orden.NombreTecnico</span>
                                        <span class="btn btn-sm btn-outline-secondary disabled" title="Cerrado">
                                            <i class="bi bi-archive me-1"></i>Cerrado
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
