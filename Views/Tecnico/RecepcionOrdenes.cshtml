@model GestorInformatico.Models.ViewModels.Ordenes.RecepcionOrdenesViewModel
@{
    ViewData["Title"] = "Recepción y Creación de Órdenes";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Tecnico" asp-action="Index" class="text-decoration-none"><i class="bi bi-house-door me-1"></i>Panel Técnico</a></li>
            <li class="breadcrumb-item active" aria-current="page">Recepción y Creación de Órdenes</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-clipboard2-plus text-info me-2"></i>Recepción y Creación de Órdenes
            </h2>
            <p class="text-muted mb-0">Registra el ingreso de nuevos equipos a reparación y genera órdenes de servicio técnico.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="Tecnico" asp-action="FlujoTrabajo" class="btn btn-outline-warning text-dark">
                <i class="bi bi-kanban me-1"></i>Ir a Flujo de Trabajo
            </a>
            <a asp-controller="Tecnico" asp-action="ClientesEquipos" class="btn btn-outline-secondary">
                <i class="bi bi-person-lines-fill me-1"></i>Ver Clientes/Equipos
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Formulario de Nueva Orden -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-primary bg-gradient text-white py-3">
                    <h5 class="card-title mb-0 fw-bold fs-6">
                        <i class="bi bi-file-earmark-plus me-2"></i>Nueva Orden de Reparación
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Tecnico" asp-action="CrearOrden" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="alert alert-danger py-2 px-3 small mb-3" style="@(ViewData.ModelState.ErrorCount > 0 ? "" : "display:none")"></div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Cliente</label>
                            <div class="input-group">
                                <select asp-for="FormularioNuevaOrden.ClienteId" asp-items="Model.ListaClientes" class="form-select">
                                    <option selected disabled>Seleccionar cliente registrado...</option>
                                </select>
                                <a asp-controller="Tecnico" asp-action="ClientesEquipos" class="btn btn-outline-secondary" title="Nuevo Cliente">
                                    <i class="bi bi-plus"></i>
                                </a>
                            </div>
                            <span asp-validation-for="FormularioNuevaOrden.ClienteId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Equipo del Cliente</label>
                            <select asp-for="FormularioNuevaOrden.EquipoId" asp-items="Model.ListaEquipos" class="form-select">
                                <option selected disabled>Seleccionar equipo...</option>
                            </select>
                            <span asp-validation-for="FormularioNuevaOrden.EquipoId" class="text-danger small"></span>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-secondary small">Fecha de Ingreso</label>
                                <input asp-for="FormularioNuevaOrden.FechaIngreso" type="datetime-local" class="form-control" />
                                <span asp-validation-for="FormularioNuevaOrden.FechaIngreso" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-secondary small">Técnico Asignado</label>
                                <select asp-for="FormularioNuevaOrden.TecnicoId" asp-items="Model.ListaTecnicos" class="form-select">
                                    <option selected disabled>Seleccionar técnico...</option>
                                </select>
                                <span asp-validation-for="FormularioNuevaOrden.TecnicoId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Descripción de la Falla / Problema Reportado</label>
                            <textarea asp-for="FormularioNuevaOrden.Descripcion" class="form-control" rows="3" placeholder="Detalla el problema que presenta el equipo según el cliente..."></textarea>
                            <span asp-validation-for="FormularioNuevaOrden.Descripcion" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Observaciones y Diagnóstico Inicial</label>
                            <textarea asp-for="FormularioNuevaOrden.Observaciones" class="form-control" rows="2" placeholder="Cargador incluido, rayones visibles, accesorios entregados..."></textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary small">Estado Inicial</label>
                            <select asp-for="FormularioNuevaOrden.Estado" asp-items="Model.ListaEstados" class="form-select" disabled>
                            </select>
                            <input type="hidden" asp-for="FormularioNuevaOrden.Estado" value="Pendiente" />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary fw-semibold py-2">
                                <i class="bi bi-check2-circle me-1"></i>Generar y Emitir Orden
                            </button>
                            <button type="reset" class="btn btn-outline-secondary btn-sm">Limpiar Formulario</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Listado de Órdenes Recientes y Filtros -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-3 mb-3">
                <div class="card-body p-3">
                    <form asp-controller="Tecnico" asp-action="RecepcionOrdenes" method="get">
                        <div class="row g-2 align-items-center">
                            <div class="col-md-7">
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                                    <input type="text" name="terminoBusqueda" class="form-control" placeholder="Buscar por Nº de orden, cliente o modelo..." value="@Context.Request.Query["terminoBusqueda"]" />
                                </div>
                            </div>
                            <div class="col-md-5 d-flex gap-2">
                                <button type="submit" class="btn btn-outline-primary flex-grow-1">
                                    <i class="bi bi-search me-1"></i>Buscar
                                </button>
                                @if (!string.IsNullOrEmpty(Context.Request.Query["terminoBusqueda"]))
                                {
                                    <a asp-controller="Tecnico" asp-action="RecepcionOrdenes" class="btn btn-outline-secondary">
                                        <i class="bi bi-x-lg"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold text-dark fs-6"><i class="bi bi-list-check me-2 text-primary"></i>Órdenes Registradas Recientemente</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Orden</th>
                                    <th>Fecha</th>
                                    <th>Cliente / Equipo</th>
                                    <th>Estado</th>
                                    <th class="text-end pe-3">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.OrdenesRecientes.Any())
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                            No hay órdenes registradas aún.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var orden in Model.OrdenesRecientes)
                                    {
                                        <tr>
                                            <td class="ps-3">
                                                <div class="fw-bold text-primary">@orden.NumeroOrdenFormateado</div>
                                                <span class="text-muted small">Técnico: @orden.NombreTecnico</span>
                                            </td>
                                            <td>
                                                <div class="small fw-semibold">@orden.FechaIngreso.ToString("dd/MM/yyyy")</div>
                                                <div class="text-muted small">@orden.FechaIngreso.ToString("HH:mm")</div>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark">@orden.NombreCliente</div>
                                                <span class="text-muted small">@orden.NombreEquipo</span>
                                            </td>
                                            <td>
                                                @if (orden.Estado == "Pendiente")
                                                {
                                                    <span class="badge bg-secondary">Pendiente</span>
                                                }
                                                else if (orden.Estado == "En reparacion")
                                                {
                                                    <span class="badge bg-warning text-dark">En reparación</span>
                                                }
                                                else if (orden.Estado == "Reparado")
                                                {
                                                    <span class="badge bg-success">Reparado</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">No se pudo</span>
                                                }
                                            </td>
                                            <td class="text-end pe-3">
                                                <a asp-controller="Tecnico" asp-action="FlujoTrabajo" class="btn btn-sm btn-outline-warning text-dark" title="Ver en Tablero">
                                                    <i class="bi bi-kanban"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
