@model GestorInformatico.Models.ViewModels.LoginViewModels.CambiarClaveViewModel
@{
    ViewData["Title"] = "Cambio de Contraseña";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white border-bottom py-3">
                    <div class="d-flex align-items-center">
                        <div class="bg-warning bg-opacity-10 text-warning p-2 rounded-circle me-3">
                            <i class="bi bi-shield-exclamation fs-3"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold text-dark mb-0">Actualización de Contraseña</h4>
                            <span class="text-muted small">Módulo Técnico • Cambio de Contraseña Temporal</span>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                        </div>
                    }

                    <!-- Aviso Informativo para el Técnico -->
                    <div class="alert alert-warning border-0 d-flex align-items-start mb-4">
                        <i class="bi bi-exclamation-triangle-fill fs-5 text-warning me-2 mt-1 flex-shrink-0"></i>
                        <div>
                            <h6 class="fw-bold mb-1 text-dark">Contraseña Provisional Detectada</h6>
                            <p class="small text-muted mb-0">
                                Tu cuenta de técnico fue creada por el administrador con una contraseña temporal. Por políticas de seguridad, debes ingresar tu contraseña actual y definir una nueva clave personal.
                            </p>
                        </div>
                    </div>

                    <form asp-controller="Tecnico" asp-action="CambiarPassword" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                        <!-- Campo 1: Contraseña Actual -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">
                                Contraseña Actual <span class="text-muted fw-normal">(Temporal asignada por el Administrador)</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-key"></i></span>
                                <input asp-for="ContrasenaActual" type="password" class="form-control border-start-0 ps-0" placeholder="Ingresa tu contraseña actual o temporal" required />
                            </div>
                            <span asp-validation-for="ContrasenaActual" class="text-danger small"></span>
                        </div>

                        <!-- Campo 2: Nueva Contraseña -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Nueva Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                <input asp-for="NuevaContrasena" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" required />
                            </div>
                            <span asp-validation-for="NuevaContrasena" class="text-danger small"></span>
                        </div>

                        <!-- Campo 3: Confirmar Nueva Contraseña -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary small">Confirmar Nueva Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock-fill"></i></span>
                                <input asp-for="ConfirmarNuevaContrasena" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" required />
                            </div>
                            <span asp-validation-for="ConfirmarNuevaContrasena" class="text-danger small"></span>
                        </div>

                        <!-- Requisitos recomendados -->
                        <div class="bg-light p-3 rounded-2 border mb-4">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-shield-lock me-1 text-primary"></i>
                                <span class="fw-semibold text-dark small">Requisitos de seguridad:</span>
                            </div>
                            <ul class="list-unstyled text-muted small mb-0 ps-3" style="font-size: 0.8rem;">
                                <li>• Mínimo 8 caracteres de longitud</li>
                                <li>• Incluir letras mayúsculas, minúsculas y números</li>
                                <li>• No utilizar datos personales obvios ni la misma clave temporal</li>
                            </ul>
                        </div>

                        <!-- Botones de Acción -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary py-2 fw-semibold">
                                <i class="bi bi-check-circle me-1"></i>Actualizar Contraseña y Continuar
                            </button>
                            <a asp-controller="Tecnico" asp-action="Index" class="btn btn-outline-secondary py-2">
                                <i class="bi bi-arrow-left me-1"></i>Ir al Panel Técnico
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
