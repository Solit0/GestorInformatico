<!-- Modal Nuevo Cliente (Maqueta Visual) -->
<div class="modal fade" id="modalCliente" tabindex="-1" aria-labelledby="modalClienteLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalClienteLabel"><i class="bi bi-person-plus me-2"></i>Registrar Nuevo Cliente</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <form onsubmit="return false;">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label fw-semibold text-secondary small">Nombre Completo / Razón Social</label>
                            <input type="text" class="form-control" placeholder="Ej. Ana Lucía Morales" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">DUI</label>
                            <input type="text" class="form-control" placeholder="00000000-0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Teléfono</label>
                            <input type="tel" class="form-control" placeholder="2222-3333" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Correo Electrónico</label>
                            <input type="email" class="form-control" placeholder="correo@cliente.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Dirección</label>
                            <input type="text" class="form-control" placeholder="Dirección completa" />
                        </div>
                        <div class="col-12">
                            <div class="card border bg-light">
                                <div class="card-body p-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="checkNotificacionCorreo" checked>
                                        <label class="form-check-label fw-semibold text-dark" for="checkNotificacionCorreo">
                                            <i class="bi bi-envelope-check me-1 text-primary"></i>Recibir notificación por correo electrónico al finalizar la reparación
                                        </label>
                                        <div class="form-text text-muted small mt-1">
                                            Se enviará un correo automático al cliente una vez el estado de la orden cambie a Reparado / Finalizado.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Guardar Cliente</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nuevo Equipo (Maqueta Visual) -->
