@model GestorInformatico.Models.ViewModels.ClientesEquipos.ClientesEquiposVM
@{
    ViewData["Title"] = "Gestión de Clientes y Equipos";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Tecnico" asp-action="Index" class="text-decoration-none"><i class="bi bi-house-door me-1"></i>Panel Técnico</a></li>
            <li class="breadcrumb-item active" aria-current="page">Gestión de Clientes y Equipos</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-person-lines-fill text-primary me-2"></i>Gestión de Clientes y Equipos
            </h2>
            <p class="text-muted mb-0">Administra los datos de los clientes y sus dispositivos asignados.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCliente">
                <i class="bi bi-person-plus me-1"></i>Nuevo Cliente
            </button>
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalEquipo">
                <i class="bi bi-laptop me-1"></i>Registrar Equipo
            </button>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Navegación por pestañas -->
    <ul class="nav nav-tabs mb-4" id="clientesEquiposTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-semibold" id="clientes-tab" data-bs-toggle="tab" data-bs-target="#clientes-content" type="button" role="tab">
                <i class="bi bi-people me-1"></i>Lista de Clientes (@Model.TotalClientes)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold" id="equipos-tab" data-bs-toggle="tab" data-bs-target="#equipos-content" type="button" role="tab">
                <i class="bi bi-pc-display me-1"></i>Equipos Registrados (@Model.TotalEquipos)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="clientesEquiposContent">
        <!-- Pestaña Clientes -->
        <div class="tab-pane fade show active" id="clientes-content" role="tabpanel">
            <form method="get" asp-controller="Tecnico" asp-action="ClientesEquipos" class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-body p-3">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                                <input type="text" name="terminoBusqueda" value="@Model.TerminoBusqueda" class="form-control" placeholder="Buscar por nombre, DUI, teléfono o correo..." />
                            </div>
                        </div>
                        <div class="col-md-3 text-md-end">
                            <button type="submit" class="btn btn-outline-primary btn-sm">Buscar</button>
                            <a asp-controller="Tecnico" asp-action="ClientesEquipos" class="btn btn-outline-secondary btn-sm">Limpiar</a>
                        </div>
                        <div class="col-md-3 text-md-end">
                            <span class="text-muted small">Mostrando @Model.Clientes.Count de @Model.TotalClientes clientes</span>
                        </div>
                    </div>
                </div>
            </form>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">ID</th>
                                <th>Nombre</th>
                                <th>DUI</th>
                                <th>Contacto</th>
                                <th>Dirección</th>
                                <th>Equipos Asociados</th>
                                <th class="text-end pe-3">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Clientes.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                        No se encontraron clientes registrados.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var cliente in Model.Clientes)
                                {
                                    <tr>
                                        <td class="ps-3 fw-semibold">@cliente.IdFormateado</td>
                                        <td>
                                            <div class="fw-bold text-dark">@cliente.Nombre</div>
                                        </td>
                                        <td><code>@cliente.DUI</code></td>
                                        <td>
                                            <div><i class="bi bi-telephone text-muted me-1"></i>@cliente.Telefono</div>
                                            <div class="text-muted small"><i class="bi bi-envelope me-1"></i>@cliente.Email</div>
                                        </td>
                                        <td>@cliente.Direccion</td>
                                        <td><span class="badge bg-primary rounded-pill">@cliente.TextoBadgeEquipos</span></td>
                                        <td class="text-end pe-3">
                                            <div class="btn-group btn-group-sm">
                                                <a asp-controller="Tecnico" asp-action="RecepcionOrdenes" class="btn btn-outline-primary" title="Crear Orden"><i class="bi bi-plus-circle"></i> Orden</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Pestaña Equipos -->
        <div class="tab-pane fade" id="equipos-content" role="tabpanel">
            <form method="get" asp-controller="Tecnico" asp-action="ClientesEquipos" class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-body p-3">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                                <input type="text" name="terminoBusqueda" value="@Model.TerminoBusqueda" class="form-control" placeholder="Buscar por marca, modelo, número de serie o cliente..." />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <select name="marcaSeleccionada" class="form-select" onchange="this.form.submit()">
                                <option value="">Todas las marcas</option>
                                @if (Model.ListaMarcas != null)
                                {
                                    @foreach (var marca in Model.ListaMarcas)
                                    {
                                        <option value="@marca.Value" selected="@marca.Selected">@marca.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3 text-md-end">
                            <a asp-controller="Tecnico" asp-action="ClientesEquipos" class="btn btn-outline-secondary btn-sm">Limpiar</a>
                        </div>
                    </div>
                </div>
            </form>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">ID</th>
                                <th>Nombre / Tipo</th>
                                <th>Marca y Modelo</th>
                                <th>Nº de Serie</th>
                                <th>Propietario / Cliente</th>
                                <th>Historial</th>
                                <th class="text-end pe-3">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Equipos.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                        No se encontraron equipos registrados.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var equipo in Model.Equipos)
                                {
                                    <tr>
                                        <td class="ps-3 fw-semibold">@equipo.IdFormateado</td>
                                        <td>
                                            <div class="fw-bold text-dark"><i class="bi bi-laptop me-1 text-primary"></i>@equipo.Nombre</div>
                                        </td>
                                        <td>@equipo.MarcaYModelo</td>
                                        <td><code>@equipo.NumeroSerie</code></td>
                                        <td>@equipo.NombreCliente</td>
                                        <td><span class="badge @equipo.ClaseColorBadge">@equipo.TextoBadgeHistorial</span></td>
                                        <td class="text-end pe-3">
                                            <div class="btn-group btn-group-sm">
                                                <a asp-controller="Tecnico" asp-action="RecepcionOrdenes" class="btn btn-outline-primary" title="Nueva Orden"><i class="bi bi-file-earmark-plus"></i></a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nuevo Cliente -->
<div class="modal fade" id="modalCliente" tabindex="-1" aria-labelledby="modalClienteLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <form id="formCliente" asp-controller="Tecnico" asp-action="CrearCliente" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="modalClienteLabel"><i class="bi bi-person-plus me-2"></i>Registrar Nuevo Cliente</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="clienteResumenErrores" class="alert alert-danger py-2 px-3 small mb-3" style="display:none"></div>
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label fw-semibold text-secondary small">Nombre Completo / Razón Social <span class="text-danger">*</span></label>
                            <input name="Nombre" id="clienteNombre" type="text" class="form-control" placeholder="Ej. Ana Lucía Morales" value="@Model.NuevoCliente?.Nombre" />
                            <div class="text-danger small mt-1" id="errorClienteNombre" style="display:none"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">DUI <span class="text-danger">*</span></label>
                            <input name="DUI" id="clienteDUI" type="text" class="form-control" placeholder="12345678-9" value="@Model.NuevoCliente?.DUI" />
                            <div class="form-text small text-muted">Formato: 8 dígitos, guion y 1 dígito</div>
                            <div class="text-danger small mt-1" id="errorClienteDUI" style="display:none"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Teléfono <span class="text-danger">*</span></label>
                            <input name="Telefono" id="clienteTelefono" type="tel" class="form-control" placeholder="2222-3333" value="@Model.NuevoCliente?.Telefono" />
                            <div class="form-text small text-muted">Formato: 4 dígitos, guion opcional, 4 dígitos</div>
                            <div class="text-danger small mt-1" id="errorClienteTelefono" style="display:none"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Correo Electrónico <span class="text-danger">*</span></label>
                            <input name="Email" id="clienteEmail" type="email" class="form-control" placeholder="correo@cliente.com" value="@Model.NuevoCliente?.Email" />
                            <div class="text-danger small mt-1" id="errorClienteEmail" style="display:none"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Dirección <span class="text-danger">*</span></label>
                            <input name="Direccion" id="clienteDireccion" type="text" class="form-control" placeholder="Dirección completa" value="@Model.NuevoCliente?.Direccion" />
                            <div class="text-danger small mt-1" id="errorClienteDireccion" style="display:none"></div>
                        </div>
                        <div class="col-12">
                            <div class="card border bg-light">
                                <div class="card-body p-3">
                                    <div class="form-check">
                                        <input name="RecibeNotificacionesCorreo" class="form-check-input" type="checkbox" id="checkNotificacionCorreo" value="true" checked>
                                        <input name="RecibeNotificacionesCorreo" type="hidden" value="false">
                                        <label class="form-check-label fw-semibold text-dark" for="checkNotificacionCorreo">
                                            <i class="bi bi-envelope-check me-1 text-primary"></i>Recibir notificación por correo electrónico al finalizar la reparación
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Cliente</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Nuevo Equipo -->
<div class="modal fade" id="modalEquipo" tabindex="-1" aria-labelledby="modalEquipoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <form id="formEquipo" asp-controller="Tecnico" asp-action="CrearEquipo" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="modalEquipoLabel"><i class="bi bi-laptop me-2"></i>Registrar Nuevo Equipo</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="equipoResumenErrores" class="alert alert-danger py-2 px-3 small mb-3" style="display:none"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Cliente Propietario <span class="text-danger">*</span></label>
                            <select name="NuevoEquipo.ClienteId" id="equipoClienteId" class="form-select">
                                <option selected disabled value="">Seleccione un cliente...</option>
                                @if (Model.NuevoEquipo?.ListaClientes != null)
                                {
                                    @foreach (var item in Model.NuevoEquipo.ListaClientes)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                            <div class="text-danger small mt-1" id="errorEquipoClienteId" style="display:none"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Nombre Identificador <span class="text-danger">*</span></label>
                            <input name="NuevoEquipo.Nombre" id="equipoNombre" type="text" class="form-control" placeholder="Ej. Laptop Trabajo / PC Oficina" value="@Model.NuevoEquipo?.Nombre" />
                            <div class="text-danger small mt-1" id="errorEquipoNombre" style="display:none"></div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small">Marca <span class="text-danger">*</span></label>
                            <input name="NuevoEquipo.Marca" id="equipoMarca" type="text" class="form-control" placeholder="Ej. Dell, HP, Lenovo" value="@Model.NuevoEquipo?.Marca" />
                            <div class="text-danger small mt-1" id="errorEquipoMarca" style="display:none"></div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small">Modelo <span class="text-danger">*</span></label>
                            <input name="NuevoEquipo.Modelo" id="equipoModelo" type="text" class="form-control" placeholder="Ej. Inspiron 15 3520" value="@Model.NuevoEquipo?.Modelo" />
                            <div class="text-danger small mt-1" id="errorEquipoModelo" style="display:none"></div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold text-secondary small">Número de Serie <span class="text-danger">*</span></label>
                            <input name="NuevoEquipo.NumeroSerie" id="equipoSerie" type="text" class="form-control" placeholder="SN-XXXX-XXXX" value="@Model.NuevoEquipo?.NumeroSerie" />
                            <div class="text-danger small mt-1" id="errorEquipoSerie" style="display:none"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Equipo</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/validacion-formularios.js"></script>
    @if (Model.ModalAbierto != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var modalEl = document.getElementById('@Model.ModalAbierto');
                if (modalEl) { new bootstrap.Modal(modalEl).show(); }
            });
        </script>
    }
}
