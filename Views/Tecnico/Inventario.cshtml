@model GestorInformatico.Models.ViewModels.Inventario.InventarioVM
@{
    ViewData["Title"] = "Inventario y Control de Refacciones";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Tecnico" asp-action="Index" class="text-decoration-none"><i class="bi bi-house-door me-1"></i>Panel Técnico</a></li>
            <li class="breadcrumb-item active" aria-current="page">Inventario y Refacciones</li>
        </ol>
    </nav>
    
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-boxes text-success me-2"></i>Inventario y Control de Refacciones
            </h2>
            <p class="text-muted mb-0">Consulta la disponibilidad de componentes, repuestos y registra su uso en las órdenes.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalAsignarRepuesto">
                <i class="bi bi-plus-circle me-1"></i>Asignar a una Orden
            </button>
            <a asp-controller="Tecnico" asp-action="FlujoTrabajo" class="btn btn-outline-warning text-dark">
                <i class="bi bi-kanban me-1"></i>Ver Órdenes Activas
            </a>
        </div>
    </div>
    
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-success border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Total Repuestos en Almacén</span>
                        <h4 class="fw-bold text-dark mb-0 mt-1">@Model.TotalRepuestos Unidades</h4>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                        <i class="bi bi-box-seam fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-warning border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Stock Bajo (&lt; 3 unid.)</span>
                        <h4 class="fw-bold text-warning mb-0 mt-1">@Model.StockBajo Artículos</h4>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                        <i class="bi bi-exclamation-triangle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-danger border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Agotados</span>
                        <h4 class="fw-bold text-danger mb-0 mt-1">@Model.Agotado Artículos</h4>
                    </div>
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle text-danger">
                        <i class="bi bi-x-octagon fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- FORMULARIO DE BÚSQUEDA Y FILTROS -->
    <form method="get" asp-controller="Tecnico" asp-action="Inventario" class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <button type="submit" class="btn btn-light border text-muted"><i class="bi bi-search"></i></button>
                        <input type="text" name="terminoBusqueda" value="@Model.TerminoBusqueda" class="form-control" placeholder="Buscar por nombre de repuesto, código o tipo..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="categoriaSeleccionada" class="form-select" onchange="this.form.submit()">
                        <option value="">Todas las categorías</option>
                        <option value="Almacenamiento" selected="@(Model.CategoriaSeleccionada == "Almacenamiento")">Almacenamiento (SSD / HDD)</option>
                        <option value="Memoria RAM" selected="@(Model.CategoriaSeleccionada == "Memoria RAM")">Memoria RAM</option>
                        <option value="Fuentes de Poder" selected="@(Model.CategoriaSeleccionada == "Fuentes de Poder")">Fuentes de Poder</option>
                        <option value="Pantallas" selected="@(Model.CategoriaSeleccionada == "Pantallas")">Pantallas / Displays</option>
                        <option value="Baterías" selected="@(Model.CategoriaSeleccionada == "Baterías")">Baterías</option>
                        <option value="Refrigeración" selected="@(Model.CategoriaSeleccionada == "Refrigeración")">Refrigeración y Pastas</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <a asp-controller="Tecnico" asp-action="Inventario" class="btn btn-outline-secondary w-100">Limpiar Filtros</a>
                </div>
            </div>
        </div>
    </form>
    
    <div class="card border-0 shadow-sm rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Nombre del Repuesto</th>
                        <th>Tipo / Categoría</th>
                        <th>Precio Unitario</th>
                        <th>Stock Disponible</th>
                        <th>Estado de Stock</th>
                        <th class="text-end pe-3">Acción Rápida</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Repuestos == null || !Model.Repuestos.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No se encontraron repuestos en el inventario.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var repuesto in Model.Repuestos)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">@repuesto.IdFormateado</td>
                                <td>
                                    <div class="fw-bold text-dark">@repuesto.Nombre</div>
                                    <span class="text-muted small">@repuesto.Descripcion</span>
                                </td>
                                <td><span class="badge bg-light text-dark border">@repuesto.Tipo</span></td>
                                <td class="fw-semibold text-dark">$@repuesto.Precio.ToString("0.00")</td>
                                
                                <td><strong class="@repuesto.ClaseColorTextoStock">@repuesto.TextoStock</strong></td>
                                <td><span class="badge @repuesto.ClaseColorBadge">@repuesto.TextoEstadoStock</span></td>
                                
                                <td class="text-end pe-3">
                                    <button type="button" class="btn btn-sm btn-outline-primary" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#modalAsignarRepuesto"
                                            disabled="@(!repuesto.PuedeUsarse)">
                                        <i class="bi bi-cart-plus me-1"></i>
                                        @(repuesto.PuedeUsarse ? "Usar en Orden" : "Sin Stock")
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalAsignarRepuesto" tabindex="-1" aria-labelledby="modalAsignarRepuestoLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold" id="modalAsignarRepuestoLabel"><i class="bi bi-cart-plus me-2"></i>Asignar Repuesto a Orden</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <form onsubmit="return false;">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Seleccionar Orden de Reparación Activa</label>
                        <select class="form-select">
                            <option selected disabled>Seleccionar orden...</option>
                            <option>#ORD-1025 - María Julia Gómez (Laptop Dell)</option>
                            <option>#ORD-1024 - Juan Carlos Pérez (PC Gamer Asus ROG)</option>
                            <option>#ORD-1026 - Soluciones IT (Impresora HP)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Repuesto a Utilizar</label>
                        <select class="form-select">
                            <option selected>SSD Kingston NV2 1TB ($68.50)</option>
                            <option>Memoria RAM Corsair Vengeance 16GB ($45.00)</option>
                            <option>Fuente de Poder EVGA 600W ($55.00)</option>
                            <option>Pasta Térmica Arctic MX-4 ($8.00)</option>
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Cantidad a Descontar</label>
                            <input type="number" class="form-control" value="1" min="1" max="10" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Precio Unitario ($)</label>
                            <input type="text" class="form-control" value="68.50" readonly />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold text-secondary small">Nota / Justificación del Uso</label>
                        <textarea class="form-control" rows="2" placeholder="Ej. Reemplazo por falla de sector en unidad original..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">Confirmar Asignación</button>
            </div>
        </div>
    </div>
</div>
