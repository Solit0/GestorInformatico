@{
    ViewData["Title"] = "Inventario y Control de Refacciones";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Tecnico" asp-action="Index" class="text-decoration-none"><i class="bi bi-house-door me-1"></i>Panel Técnico</a></li>
            <li class="breadcrumb-item active" aria-current="page">Inventario y Refacciones</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-boxes text-success me-2"></i>Inventario y Control de Refacciones
            </h2>
            <p class="text-muted mb-0">Consulta la disponibilidad de componentes, repuestos y registra su uso en las órdenes.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalAsignarRepuesto">
                <i class="bi bi-plus-circle me-1"></i>Asignar a una Orden
            </button>
            <a asp-controller="Tecnico" asp-action="FlujoTrabajo" class="btn btn-outline-warning text-dark">
                <i class="bi bi-kanban me-1"></i>Ver Órdenes Activas
            </a>
        </div>
    </div>

    <!-- Tarjetas de Resumen de Inventario -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-success border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Total Repuestos en Almacén</span>
                        <h4 class="fw-bold text-dark mb-0 mt-1">48 Unidades</h4>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                        <i class="bi bi-box-seam fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-warning border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Stock Bajo (&lt; 3 unid.)</span>
                        <h4 class="fw-bold text-warning mb-0 mt-1">2 Artículos</h4>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                        <i class="bi bi-exclamation-triangle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-danger border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Agotados</span>
                        <h4 class="fw-bold text-danger mb-0 mt-1">1 Artículo</h4>
                    </div>
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle text-danger">
                        <i class="bi bi-x-octagon fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros de búsqueda -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Buscar por nombre de repuesto, código o tipo..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <select class="form-select">
                        <option selected>Todas las categorías</option>
                        <option>Almacenamiento (SSD / HDD)</option>
                        <option>Memoria RAM</option>
                        <option>Fuentes de Poder</option>
                        <option>Pantallas / Displays</option>
                        <option>Baterías</option>
                        <option>Refrigeración y Pastas</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select">
                        <option selected>Todos los estados de stock</option>
                        <option>En Stock</option>
                        <option>Stock Bajo</option>
                        <option>Agotado</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Refacciones -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Nombre del Repuesto</th>
                        <th>Tipo / Categoría</th>
                        <th>Precio Unitario</th>
                        <th>Stock Disponible</th>
                        <th>Estado de Stock</th>
                        <th class="text-end pe-3">Acción Rápida</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-3 fw-semibold">#REP-01</td>
                        <td>
                            <div class="fw-bold text-dark">SSD Kingston NV2 1TB NVMe PCIe 4.0</div>
                            <span class="text-muted small">Almacenamiento de alta velocidad</span>
                        </td>
                        <td><span class="badge bg-light text-dark border">Almacenamiento</span></td>
                        <td class="fw-semibold text-dark">$68.50</td>
                        <td><strong class="text-success">14 unidades</strong></td>
                        <td><span class="badge bg-success">En Stock</span></td>
                        <td class="text-end pe-3">
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalAsignarRepuesto">
                                <i class="bi bi-cart-plus me-1"></i>Usar en Orden
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-3 fw-semibold">#REP-02</td>
                        <td>
                            <div class="fw-bold text-dark">Memoria RAM Corsair Vengeance 16GB DDR4 3200MHz</div>
                            <span class="text-muted small">Módulo para computadoras de escritorio</span>
                        </td>
                        <td><span class="badge bg-light text-dark border">Memoria RAM</span></td>
                        <td class="fw-semibold text-dark">$45.00</td>
                        <td><strong class="text-success">9 unidades</strong></td>
                        <td><span class="badge bg-success">En Stock</span></td>
                        <td class="text-end pe-3">
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalAsignarRepuesto">
                                <i class="bi bi-cart-plus me-1"></i>Usar en Orden
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-3 fw-semibold">#REP-03</td>
                        <td>
                            <div class="fw-bold text-dark">Fuente de Poder EVGA 600W 80 Plus White</div>
                            <span class="text-muted small">Certificación 80 Plus para PC</span>
                        </td>
                        <td><span class="badge bg-light text-dark border">Fuentes de Poder</span></td>
                        <td class="fw-semibold text-dark">$55.00</td>
                        <td><strong class="text-warning">2 unidades</strong></td>
                        <td><span class="badge bg-warning text-dark">Stock Bajo</span></td>
                        <td class="text-end pe-3">
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalAsignarRepuesto">
                                <i class="bi bi-cart-plus me-1"></i>Usar en Orden
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-3 fw-semibold">#REP-04</td>
                        <td>
                            <div class="fw-bold text-dark">Batería Original MacBook Pro 14" M1 (A2442)</div>
                            <span class="text-muted small">Repuesto OEM para Laptop Apple</span>
                        </td>
                        <td><span class="badge bg-light text-dark border">Baterías</span></td>
                        <td class="fw-semibold text-dark">$120.00</td>
                        <td><strong class="text-danger">0 unidades</strong></td>
                        <td><span class="badge bg-danger">Agotado</span></td>
                        <td class="text-end pe-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                                Sin Stock
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-3 fw-semibold">#REP-05</td>
                        <td>
                            <div class="fw-bold text-dark">Pasta Térmica Arctic MX-4 (4g)</div>
                            <span class="text-muted small">Compuesto térmico de alto rendimiento</span>
                        </td>
                        <td><span class="badge bg-light text-dark border">Refrigeración</span></td>
                        <td class="fw-semibold text-dark">$8.00</td>
                        <td><strong class="text-success">23 unidades</strong></td>
                        <td><span class="badge bg-success">En Stock</span></td>
                        <td class="text-end pe-3">
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalAsignarRepuesto">
                                <i class="bi bi-cart-plus me-1"></i>Usar en Orden
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Asignar Repuesto a Orden (Maqueta Visual) -->
<div class="modal fade" id="modalAsignarRepuesto" tabindex="-1" aria-labelledby="modalAsignarRepuestoLabel" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold" id="modalAsignarRepuestoLabel"><i class="bi bi-cart-plus me-2"></i>Asignar Repuesto a Orden</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <form onsubmit="return false;">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Seleccionar Orden de Reparación Activa</label>
                        <select class="form-select">
                            <option selected disabled>Seleccionar orden...</option>
                            <option>#ORD-1025 - María Julia Gómez (Laptop Dell)</option>
                            <option>#ORD-1024 - Juan Carlos Pérez (PC Gamer Asus ROG)</option>
                            <option>#ORD-1026 - Soluciones IT (Impresora HP)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-secondary small">Repuesto a Utilizar</label>
                        <select class="form-select">
                            <option selected>SSD Kingston NV2 1TB ($68.50)</option>
                            <option>Memoria RAM Corsair Vengeance 16GB ($45.00)</option>
                            <option>Fuente de Poder EVGA 600W ($55.00)</option>
                            <option>Pasta Térmica Arctic MX-4 ($8.00)</option>
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Cantidad a Descontar</label>
                            <input type="number" class="form-control" value="1" min="1" max="10" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Precio Unitario ($)</label>
                            <input type="text" class="form-control" value="68.50" readonly />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold text-secondary small">Nota / Justificación del Uso</label>
                        <textarea class="form-control" rows="2" placeholder="Ej. Reemplazo por falla de sector en unidad original..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">Confirmar Asignación</button>
            </div>
        </div>
    </div>
</div>
