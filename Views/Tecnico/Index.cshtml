@model GestorInformatico.Models.ViewModels.TecnicoDashboardViewModel
@{
    ViewData["Title"] = "Panel del Técnico";
}

<div class="container py-4">
    <!-- Header del Dashboard -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-tools text-primary me-2"></i>Panel Principal del Técnico
            </h2>
            <p class="text-muted mb-0">Bienvenido al espacio de trabajo técnico. Selecciona un módulo para comenzar.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="Tecnico" asp-action="CambiarPassword" class="btn btn-outline-warning text-dark shadow-sm">
                <i class="bi bi-key me-1"></i>Cambiar Contraseña
            </a>
            <a asp-controller="Tecnico" asp-action="RecepcionOrdenes" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i>Nueva Orden
            </a>
            <a asp-controller="Tecnico" asp-action="FlujoTrabajo" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-kanban me-1"></i>Ver Tablero de Trabajo
            </a>
        </div>
    </div>

    <!-- Tarjetas de Resumen Rápido -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm border-start border-primary border-4 rounded-3 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Órdenes Pendientes</span>
                            <h4 class="fw-bold text-primary mb-0 mt-1">@Model.OrdenesPendientes</h4>
                        </div>
                        <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                            <i class="bi bi-clock-history fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm border-start border-warning border-4 rounded-3 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">En Reparación</span>
                            <h4 class="fw-bold text-warning mb-0 mt-1">@Model.OrdenesEnReparacion</h4>
                        </div>
                        <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                            <i class="bi bi-gear-wide-connected fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm border-start border-success border-4 rounded-3 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Listos para Entrega</span>
                            <h4 class="fw-bold text-success mb-0 mt-1">@Model.ListasParaEntrega</h4>
                        </div>
                        <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                            <i class="bi bi-check-circle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm border-start border-danger border-4 rounded-3 h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <span class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem;">Stock Crítico</span>
                            <h4 class="fw-bold text-danger mb-0 mt-1">@Model.StockCritico</h4>
                        </div>
                        <div class="bg-danger bg-opacity-10 p-3 rounded-circle text-danger">
                            <i class="bi bi-exclamation-triangle fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Módulos Principales de Navegación -->
    <h4 class="fw-bold text-secondary mb-3 fs-5">Módulos del Sistema</h4>
    <div class="row g-4 mb-5">
        
        <!-- Módulo 1: Gestión de Clientes y Equipos -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all rounded-3">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="mb-3">
                        <span class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-3 p-3 shadow-sm">
                            <i class="bi bi-person-lines-fill fs-3"></i>
                        </span>
                    </div>
                    <h5 class="fw-bold text-dark">Gestión de Clientes y Equipos</h5>
                    <p class="text-muted small flex-grow-1">
                        Consulta y administración de clientes, registro de equipos informáticos, marcas, modelos y números de serie.
                    </p>
                    <div class="mt-3">
                        <a asp-controller="Tecnico" asp-action="ClientesEquipos" class="btn btn-outline-primary w-100 fw-semibold">
                            Ingresar al Módulo <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Módulo 2: Recepción y Creación de Órdenes -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all rounded-3">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="mb-3">
                        <span class="d-inline-flex align-items-center justify-content-center bg-info text-white rounded-3 p-3 shadow-sm">
                            <i class="bi bi-clipboard2-plus fs-3"></i>
                        </span>
                    </div>
                    <h5 class="fw-bold text-dark">Recepción y Creación de Órdenes</h5>
                    <p class="text-muted small flex-grow-1">
                        Registro inicial de ingresos de equipos para reparación, diagnóstico previo, fallas reportadas y emisión de órdenes.
                    </p>
                    <div class="mt-3">
                        <a asp-controller="Tecnico" asp-action="RecepcionOrdenes" class="btn btn-outline-info w-100 fw-semibold">
                            Ingresar al Módulo <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Módulo 3: Flujo de Trabajo y Seguimiento de Estados -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all rounded-3">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="mb-3">
                        <span class="d-inline-flex align-items-center justify-content-center bg-warning text-dark rounded-3 p-3 shadow-sm">
                            <i class="bi bi-kanban fs-3"></i>
                        </span>
                    </div>
                    <h5 class="fw-bold text-dark">Flujo de Trabajo y Estados</h5>
                    <p class="text-muted small flex-grow-1">
                        Tablero de avance: Pendiente, En reparación, Reparado o No reparable, asignación de técnicos y registro de avances.
                    </p>
                    <div class="mt-3">
                        <a asp-controller="Tecnico" asp-action="FlujoTrabajo" class="btn btn-outline-warning text-dark w-100 fw-semibold">
                            Ingresar al Módulo <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Módulo 4: Inventario y Control de Refacciones -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all rounded-3">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="mb-3">
                        <span class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-3 p-3 shadow-sm">
                            <i class="bi bi-boxes fs-3"></i>
                        </span>
                    </div>
                    <h5 class="fw-bold text-dark">Inventario y Refacciones</h5>
                    <p class="text-muted small flex-grow-1">
                        Consulta de repuestos disponibles en almacén, precios, stock actual y asignación de piezas a órdenes en curso.
                    </p>
                    <div class="mt-3">
                        <a asp-controller="Tecnico" asp-action="Inventario" class="btn btn-outline-success w-100 fw-semibold">
                            Ingresar al Módulo <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
