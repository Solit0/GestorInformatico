@model GestorInformatico.Models.ViewModels.LoginViewModels.InicioSesionViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    ViewData["HideNavbar"] = true;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="bg-primary bg-gradient text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                            <i class="bi bi-shield-lock fs-2"></i>
                        </div>
                        <h3 class="fw-bold text-dark">Iniciar Sesión</h3>
                        <p class="text-muted small">Ingresa tus credenciales para acceder a GestorInformático</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="alert alert-danger py-2 px-3 small border-0 mb-3">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-0"></div>
                        </div>
                    }

                    <form asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                        <div class="mb-3">
                            <label asp-for="CorreoElectronico" class="form-label fw-semibold text-secondary small">Correo Electrónico / Usuario</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="CorreoElectronico" class="form-control border-start-0 ps-0" placeholder="usuario@ejemplo.com" required />
                            </div>
                            <span asp-validation-for="CorreoElectronico" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label asp-for="Contrasena" class="form-label fw-semibold text-secondary small mb-0">Contraseña</label>
                                <a asp-controller="Auth" asp-action="RecuperarPassword" class="text-decoration-none small text-primary">¿Olvidaste tu contraseña?</a>
                            </div>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                <input asp-for="Contrasena" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" required />
                            </div>
                            <span asp-validation-for="Contrasena" class="text-danger small"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="RecordarSesion" class="form-check-input" type="checkbox" id="rememberMe">
                            <label class="form-check-label text-muted small" for="rememberMe">
                                Recordar mi sesión
                            </label>
                        </div>

                        <div class="d-grid gap-2 mb-4">
                            <button type="submit" class="btn btn-primary py-2 fw-semibold">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Acceder
                            </button>
                        </div>

                        <div class="text-center p-2 rounded bg-light border">
                            <p class="text-muted small mb-0">
                                <i class="bi bi-info-circle me-1 text-primary"></i>¿Necesitas una cuenta? El registro de técnicos es gestionado por el administrador.
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
