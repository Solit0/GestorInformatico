@{
    ViewData["Title"] = "Recuperar Contraseña";
    ViewData["HideNavbar"] = true;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="bg-primary bg-gradient text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                            <i class="bi bi-key-fill fs-2"></i>
                        </div>
                        <h3 class="fw-bold text-dark">Recuperar Contraseña</h3>
                        <p class="text-muted small">Ingresa el correo electrónico asociado a tu cuenta para restablecer tu acceso</p>
                    </div>

                    <div class="alert alert-info py-2 px-3 small border-0 d-flex align-items-center mb-4">
                        <i class="bi bi-info-circle-fill me-2 fs-5 text-info"></i>
                        <span>Te enviaremos un enlace de verificación a tu bandeja de entrada con instrucciones para crear una nueva clave.</span>
                    </div>

                    <form action="#" method="post" onsubmit="return false;">
                        <div class="mb-4">
                            <label for="email" class="form-label fw-semibold text-secondary small">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                <input type="email" class="form-control border-start-0 ps-0" id="email" placeholder="correo@ejemplo.com" required />
                            </div>
                            <div class="form-text text-muted small mt-1">Asegúrate de ingresar la dirección registrada en el sistema.</div>
                        </div>

                        <div class="d-grid gap-2 mb-4">
                            <button type="button" class="btn btn-primary py-2 fw-semibold">
                                <i class="bi bi-envelope-arrow-up me-2"></i>Recuperar contraseña
                            </button>
                        </div>

                        <div class="text-center">
                            <a asp-controller="Auth" asp-action="Login" class="text-decoration-none small text-primary fw-semibold">
                                <i class="bi bi-arrow-left me-1"></i>Volver a Iniciar Sesión
                            </a>
                        </div>
                    </form>

                    <hr class="my-4 text-muted opacity-25" />

                    <!-- Simulación de Enlace para Revisión de Vistas -->
                    <div class="card bg-light border p-3 rounded-3 text-center">
                        <span class="text-muted small fw-semibold d-block mb-2">
                            <i class="bi bi-eye me-1"></i>Acceso directo para revisión:
                        </span>
                        <p class="text-muted small mb-2" style="font-size: 0.8rem;">
                            Simular la apertura del enlace que recibiría el usuario por correo electrónico:
                        </p>
                        <a asp-controller="Auth" asp-action="RestablecerPassword" class="btn btn-sm btn-outline-primary fw-semibold">
                            <i class="bi bi-link-45deg me-1"></i>Ver Vista de Restablecer Contraseña
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
