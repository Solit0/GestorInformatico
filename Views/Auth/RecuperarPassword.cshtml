@model GestorInformatico.Models.ViewModels.LoginViewModels.RecuperarClaveViewModel
@{
    ViewData["Title"] = "Recuperar Contraseña";
    ViewData["HideNavbar"] = true;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="bg-primary bg-gradient text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                            <i class="bi bi-key-fill fs-2"></i>
                        </div>
                        <h3 class="fw-bold text-dark">Recuperar Contraseña</h3>
                        <p class="text-muted small">Ingresa el correo electrónico asociado a tu cuenta para restablecer tu acceso</p>
                    </div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success py-2 px-3 small border-0 d-flex align-items-center mb-4">
                            <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>
                            <span>@TempData["Success"]</span>
                        </div>
                    }

                    <div class="alert alert-info py-2 px-3 small border-0 d-flex align-items-center mb-4">
                        <i class="bi bi-info-circle-fill me-2 fs-5 text-info"></i>
                        <span>Te enviaremos un enlace de verificación a tu bandeja de entrada con instrucciones para crear una nueva clave.</span>
                    </div>

                    <form asp-controller="Auth" asp-action="RecuperarPassword" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-4">
                            <label asp-for="CorreoElectronico" class="form-label fw-semibold text-secondary small">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="CorreoElectronico" type="email" class="form-control border-start-0 ps-0" placeholder="correo@ejemplo.com" />
                            </div>
                            <span asp-validation-for="CorreoElectronico" class="text-danger small"></span>
                            <div class="form-text text-muted small mt-1">Asegúrate de ingresar la dirección registrada en el sistema.</div>
                        </div>

                        <div class="d-grid gap-2 mb-4">
                            <button type="submit" class="btn btn-primary py-2 fw-semibold">
                                <i class="bi bi-envelope-arrow-up me-2"></i>Recuperar contraseña
                            </button>
                        </div>

                        <div class="text-center">
                            <a asp-controller="Auth" asp-action="Login" class="text-decoration-none small text-primary fw-semibold">
                                <i class="bi bi-arrow-left me-1"></i>Volver a Iniciar Sesión
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
