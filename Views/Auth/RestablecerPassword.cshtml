@model GestorInformatico.Models.ViewModels.LoginViewModels.RestablecerClaveViewModel
@{
    ViewData["Title"] = "Restablecer Contraseña";
    ViewData["HideNavbar"] = true;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="bg-success bg-gradient text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
                            <i class="bi bi-shield-check fs-2"></i>
                        </div>
                        <h3 class="fw-bold text-dark">Restablecer Contraseña</h3>
                        <p class="text-muted small">Crea una nueva contraseña para recuperar el acceso a tu cuenta</p>
                    </div>

                    <div class="alert alert-success py-2 px-3 small border-0 d-flex align-items-center mb-4">
                        <i class="bi bi-patch-check-fill me-2 fs-5 text-success"></i>
                        <div>
                            <strong>Enlace verificado:</strong> Se ha validado el token de seguridad enviado a tu correo.
                        </div>
                    </div>

                    <form asp-controller="Auth" asp-action="RestablecerPassword" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="Token" />

                        <div class="mb-3">
                            <label asp-for="NuevaContrasena" class="form-label fw-semibold text-secondary small">Nueva Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                <input asp-for="NuevaContrasena" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="NuevaContrasena" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmarContrasena" class="form-label fw-semibold text-secondary small">Confirmar Nueva Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock-fill"></i></span>
                                <input asp-for="ConfirmarContrasena" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                        </div>

                        <!-- Requisitos de seguridad -->
                        <div class="card bg-light border-0 p-3 rounded-2 mb-4">
                            <span class="text-muted small fw-semibold d-block mb-1">Tu contraseña debe incluir:</span>
                            <ul class="list-unstyled text-muted small mb-0" style="font-size: 0.8rem;">
                                <li><i class="bi bi-check2 text-success me-1"></i>Mínimo 8 caracteres</li>
                                <li><i class="bi bi-check2 text-success me-1"></i>Al menos una letra mayúscula y una minúscula</li>
                                <li><i class="bi bi-check2 text-success me-1"></i>Al menos un número o símbolo especial</li>
                            </ul>
                        </div>

                        <div class="d-grid gap-2 mb-4">
                            <button type="submit" class="btn btn-success py-2 fw-semibold">
                                <i class="bi bi-check-lg me-1"></i>Restablecer Contraseña
                            </button>
                        </div>

                        <div class="text-center">
                            <a asp-controller="Auth" asp-action="Login" class="text-decoration-none small text-primary fw-semibold">
                                <i class="bi bi-arrow-left me-1"></i>Volver a Iniciar Sesión
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
