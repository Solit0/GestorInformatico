@{
    ViewData["Title"] = "Control General de Inventario";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Administrador" asp-action="Index" class="text-decoration-none"><i class="bi bi-shield-lock me-1"></i>Panel Administrador</a></li>
            <li class="breadcrumb-item active" aria-current="page">Control de Inventario</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-box-seam-fill text-success me-2"></i>Control General de Inventario
            </h2>
            <p class="text-muted mb-0">Gestión de catálogo de repuestos, costos, precios, compras y stock de seguridad.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <button type="button" class="btn btn-success shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNuevoRepuesto">
                <i class="bi bi-plus-circle me-1"></i>Nuevo Repuesto
            </button>
            <a asp-controller="Administrador" asp-action="Usuarios" class="btn btn-outline-secondary">
                <i class="bi bi-people me-1"></i>Gestionar Usuarios
            </a>
        </div>
    </div>

    <!-- KPIs Administrativos del Almacén -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-primary border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Total Repuestos</span>
                        <h4 class="fw-bold text-dark mb-0 mt-1">48 Unid.</h4>
                        <span class="text-muted small">5 tipos registrados</span>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                        <i class="bi bi-boxes fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-success border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Valor Total Estimado</span>
                        <h4 class="fw-bold text-success mb-0 mt-1">$2,840.00</h4>
                        <span class="text-success small">Precio de venta público</span>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                        <i class="bi bi-cash-stack fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-warning border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Stock Bajo Alerta</span>
                        <h4 class="fw-bold text-warning mb-0 mt-1">2 Ítems</h4>
                        <span class="text-warning small">&le; 3 unidades restantes</span>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                        <i class="bi bi-exclamation-triangle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-danger border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Sin Existencias</span>
                        <h4 class="fw-bold text-danger mb-0 mt-1">1 Ítem</h4>
                        <span class="text-danger small">Pendiente de compra</span>
                    </div>
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle text-danger">
                        <i class="bi bi-x-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Barra de Filtros y Búsqueda -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Buscar por código, descripción o categoría..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select">
                        <option selected>Todas las categorías</option>
                        <option>Almacenamiento (SSD/HDD)</option>
                        <option>Memoria RAM</option>
                        <option>Fuentes de Poder</option>
                        <option>Baterías</option>
                        <option>Refrigeración</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select">
                        <option selected>Todos los estados</option>
                        <option>En Stock</option>
                        <option>Stock Bajo</option>
                        <option>Agotado</option>
                    </select>
                </div>
                <div class="col-md-2 text-md-end">
                    <button type="button" class="btn btn-outline-success w-100">
                        <i class="bi bi-file-earmark-excel me-1"></i>Exportar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Gestión de Inventario -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Nombre y Descripción</th>
                        <th>Tipo / Categoría</th>
                        <th>Precio Unitario</th>
                        <th>Stock Actual</th>
                        <th>Estado</th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-3 fw-semibold">#1</td>
                        <td>
                            <div class="fw-bold text-dark">SSD Kingston NV2 1TB NVMe PCIe 4.0</div>
                            <span class="text-muted small">Cód: SNV2S/1000G | Marca: Kingston</span>
                        </td>
                        <td><span class="badge bg-light text-dark border">Almacenamiento</span></td>
                        <td class="fw-bold text-dark">$68.50</td>
                        <td>
                            <div class="fw-semibold">14 unid.</div>
                            <span class="text-muted small">Mínimo: 3</span>
                        </td>
                        <td><span class="badge bg-success-subtle text-success border border-success-subtle">En Stock</span></td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-secondary" title="Editar Repuesto"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-outline-primary" title="Añadir Stock"><i class="bi bi-plus-slash-minus"></i></button>
                                <button class="btn btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-3 fw-semibold">#2</td>
                        <td>
                            <div class="fw-bold text-dark">Memoria RAM Corsair Vengeance 16GB DDR4 3200MHz</div>
                            <span class="text-muted small">Cód: CMK16GX4M1E3200C16 | Marca: Corsair</span>
                        </td>
                        <td><span class="badge bg-light text-dark border">Memoria RAM</span></td>
                        <td class="fw-bold text-dark">$45.00</td>
                        <td>
                            <div class="fw-semibold">9 unid.</div>
                            <span class="text-muted small">Mínimo: 4</span>
                        </td>
                        <td><span class="badge bg-success-subtle text-success border border-success-subtle">En Stock</span></td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-secondary" title="Editar Repuesto"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-outline-primary" title="Añadir Stock"><i class="bi bi-plus-slash-minus"></i></button>
                                <button class="btn btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-3 fw-semibold">#3</td>
                        <td>
                            <div class="fw-bold text-dark">Fuente de Poder EVGA 600W 80 Plus White</div>
                            <span class="text-muted small">Cód: 100-W1-0600-K1 | Marca: EVGA</span>
                        </td>
                        <td><span class="badge bg-light text-dark border">Fuentes de Poder</span></td>
                        <td class="fw-bold text-dark">$55.00</td>
                        <td>
                            <div class="fw-semibold text-warning">2 unid.</div>
                            <span class="text-muted small">Mínimo: 3</span>
                        </td>
                        <td><span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Stock Bajo</span></td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-secondary" title="Editar Repuesto"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-outline-primary" title="Añadir Stock"><i class="bi bi-plus-slash-minus"></i></button>
                                <button class="btn btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-3 fw-semibold">#4</td>
                        <td>
                            <div class="fw-bold text-dark">Batería Original MacBook Pro 14" M1 (A2442)</div>
                            <span class="text-muted small">Cód: A2519 | Marca: Apple OEM</span>
                        </td>
                        <td><span class="badge bg-light text-dark border">Baterías</span></td>
                        <td class="fw-bold text-dark">$120.00</td>
                        <td>
                            <div class="fw-semibold text-danger">0 unid.</div>
                            <span class="text-muted small">Mínimo: 2</span>
                        </td>
                        <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle">Agotado</span></td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-secondary" title="Editar Repuesto"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-outline-success" title="Registrar Compra"><i class="bi bi-cart-plus"></i> Comprar</button>
                                <button class="btn btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-3 fw-semibold">#5</td>
                        <td>
                            <div class="fw-bold text-dark">Pasta Térmica Arctic MX-4 (4g)</div>
                            <span class="text-muted small">Cód: ACTCP00002B | Marca: Arctic</span>
                        </td>
                        <td><span class="badge bg-light text-dark border">Refrigeración</span></td>
                        <td class="fw-bold text-dark">$8.00</td>
                        <td>
                            <div class="fw-semibold">23 unid.</div>
                            <span class="text-muted small">Mínimo: 5</span>
                        </td>
                        <td><span class="badge bg-success-subtle text-success border border-success-subtle">En Stock</span></td>
                        <td class="text-end pe-3">
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-secondary" title="Editar Repuesto"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-outline-primary" title="Añadir Stock"><i class="bi bi-plus-slash-minus"></i></button>
                                <button class="btn btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Nuevo Repuesto (Maqueta Visual) -->
<div class="modal fade" id="modalNuevoRepuesto" tabindex="-1" aria-labelledby="modalNuevoRepuestoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold" id="modalNuevoRepuestoLabel"><i class="bi bi-plus-circle me-2"></i>Registrar Nuevo Repuesto</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <form onsubmit="return false;">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label fw-semibold text-secondary small">Nombre Completo del Repuesto / Componente</label>
                            <input type="text" class="form-control" placeholder="Ej. SSD Western Digital Black SN770 1TB" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Tipo / Categoría</label>
                            <select class="form-select">
                                <option selected disabled>Seleccionar categoría...</option>
                                <option>Almacenamiento</option>
                                <option>Memoria RAM</option>
                                <option>Fuentes de Poder</option>
                                <option>Pantallas / Displays</option>
                                <option>Baterías</option>
                                <option>Refrigeración</option>
                                <option>Otros periféricos</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Precio de Venta ($)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" step="0.01" class="form-control" placeholder="0.00" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Stock Inicial</label>
                            <input type="number" min="0" class="form-control" placeholder="0" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary small">Stock Mínimo de Alerta</label>
                            <input type="number" min="1" class="form-control" placeholder="3" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" data-bs-dismiss="modal">Guardar en Inventario</button>
            </div>
        </div>
    </div>
</div>
