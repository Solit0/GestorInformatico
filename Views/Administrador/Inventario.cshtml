@model GestorInformatico.Models.ViewModels.Inventario.GestionInventarioViewModel
@{
    ViewData["Title"] = "Control General de Inventario";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Administrador" asp-action="Index" class="text-decoration-none"><i class="bi bi-shield-lock me-1"></i>Panel Administrador</a></li>
            <li class="breadcrumb-item active" aria-current="page">Control de Inventario</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-box-seam-fill text-success me-2"></i>Control General de Inventario
            </h2>
            <p class="text-muted mb-0">Gestión de catálogo de repuestos, costos, precios, compras y stock de seguridad.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <button type="button" class="btn btn-success shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNuevoRepuesto">
                <i class="bi bi-plus-circle me-1"></i>Nuevo Repuesto
            </button>
            <button type="button" class="btn btn-outline-success shadow-sm" data-bs-toggle="modal" data-bs-target="#modalNuevaCategoria">
                <i class="bi bi-tags me-1"></i>Agregar Categoría
            </button>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- KPIs Administrativos del Almacén -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-primary border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Total Repuestos</span>
                        <h4 class="fw-bold text-dark mb-0 mt-1">@Model.TotalUnidades Unid.</h4>
                        <span class="text-muted small">@Model.TiposRegistrados tipos registrados</span>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                        <i class="bi bi-boxes fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-success border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Valor Total Estimado</span>
                        <h4 class="fw-bold text-success mb-0 mt-1">@($"${Model.ValorTotalEstimado:N2}")</h4>
                        <span class="text-success small">Precio de venta público</span>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                        <i class="bi bi-cash-stack fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-warning border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Stock Bajo Alerta</span>
                        <h4 class="fw-bold text-warning mb-0 mt-1">@Model.StockBajo Ítems</h4>
                        <span class="text-warning small">&le; 3 unidades restantes</span>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                        <i class="bi bi-exclamation-triangle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-danger border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Sin Existencias</span>
                        <h4 class="fw-bold text-danger mb-0 mt-1">@Model.Agotado Ítems</h4>
                        <span class="text-danger small">Pendiente de reabastecimiento</span>
                    </div>
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle text-danger">
                        <i class="bi bi-x-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Barra de Filtros y Búsqueda -->
    <form method="get" asp-controller="Administrador" asp-action="Inventario" class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="terminoBusqueda" value="@Model.TerminoBusqueda" class="form-control" placeholder="Buscar por código, descripción o categoría..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="categoriaSeleccionada" class="form-select" onchange="this.form.submit()">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.CategoriaSeleccionada))">Todas las categorías</option>
                        @foreach (var cat in Model.CategoriasDisponibles)
                        {
                            <option value="@cat" selected="@(Model.CategoriaSeleccionada == cat)">@cat</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="estadoSeleccionado" class="form-select" onchange="this.form.submit()">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.EstadoSeleccionado))">Todos los estados</option>
                        <option value="En Stock" selected="@(Model.EstadoSeleccionado == "En Stock")">En Stock</option>
                        <option value="Stock Bajo" selected="@(Model.EstadoSeleccionado == "Stock Bajo")">Stock Bajo</option>
                        <option value="Agotado" selected="@(Model.EstadoSeleccionado == "Agotado")">Agotado</option>
                    </select>
                </div>
                <div class="col-md-2 text-md-end d-flex gap-2">
                    <button type="submit" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-funnel me-1"></i>Filtrar
                    </button>
                    @if (!string.IsNullOrEmpty(Model.TerminoBusqueda) || !string.IsNullOrEmpty(Model.CategoriaSeleccionada) || !string.IsNullOrEmpty(Model.EstadoSeleccionado))
                    {
                        <a asp-controller="Administrador" asp-action="Inventario" class="btn btn-outline-danger" title="Limpiar filtros">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </form>

    <!-- Tabla de Gestión de Inventario -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Nombre y Descripción</th>
                        <th>Tipo / Categoría</th>
                        <th>Precio Unitario</th>
                        <th>Stock Actual</th>
                        <th>Estado</th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Repuestos == null || !Model.Repuestos.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-boxes fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                No se encontraron repuestos registrados con los criterios seleccionados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var repuesto in Model.Repuestos)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">#@repuesto.Id</td>
                                <td>
                                    <div class="fw-bold text-dark">@repuesto.Nombre</div>
                                    <span class="text-muted small">Cód: REP-@repuesto.Id</span>
                                </td>
                                <td><span class="badge bg-light text-dark border">@repuesto.Tipo</span></td>
                                <td class="fw-bold text-dark">@($"${repuesto.Precio:N2}")</td>
                                <td>
                                    <div class="fw-semibold @(repuesto.StockDisponible == 0 ? "text-danger" : (repuesto.StockDisponible < 3 ? "text-warning" : ""))">@repuesto.StockDisponible unid.</div>
                                    <span class="text-muted small">Mínimo: @repuesto.StockMinimo</span>
                                </td>
                                <td>
                                    @if (repuesto.StockDisponible == 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Agotado</span>
                                    }
                                    else if (repuesto.StockDisponible < 3)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Stock Bajo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">En Stock</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-secondary" title="Editar Repuesto" data-bs-toggle="modal" data-bs-target="#modalEditarRepuesto_@repuesto.Id">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-outline-primary" title="Añadir Stock" data-bs-toggle="modal" data-bs-target="#modalAñadirStock_@repuesto.Id">
                                            <i class="bi bi-plus-slash-minus"></i>
                                        </button>
                                        <form method="post" asp-controller="Administrador" asp-action="EliminarRepuesto" asp-route-id="@repuesto.Id" class="d-inline" onsubmit="return confirm('¿Está seguro de eliminar el repuesto @repuesto.Nombre?');">
                                            <button type="submit" class="btn btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Nuevo Repuesto -->
<div class="modal fade" id="modalNuevoRepuesto" tabindex="-1" aria-labelledby="modalNuevoRepuestoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold" id="modalNuevoRepuestoLabel"><i class="bi bi-plus-circle me-2"></i>Registrar Nuevo Repuesto</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form method="post" asp-controller="Administrador" asp-action="CrearRepuesto">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="NuevoRepuesto.Nombre" class="form-label fw-semibold text-secondary small">Nombre Completo del Repuesto / Componente</label>
                            <input asp-for="NuevoRepuesto.Nombre" class="form-control" placeholder="Ej. SSD Western Digital Black SN770 1TB" required />
                            <span asp-validation-for="NuevoRepuesto.Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NuevoRepuesto.Tipo" class="form-label fw-semibold text-secondary small">Tipo / Categoría</label>
                            <select asp-for="NuevoRepuesto.Tipo" class="form-select" required>
                                <option value="" selected disabled>Seleccionar categoría...</option>
                                @foreach (var cat in Model.CategoriasDisponibles)
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                            <span asp-validation-for="NuevoRepuesto.Tipo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NuevoRepuesto.Precio" class="form-label fw-semibold text-secondary small">Precio de Venta ($)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="NuevoRepuesto.Precio" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" required />
                            </div>
                            <span asp-validation-for="NuevoRepuesto.Precio" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NuevoRepuesto.StockDisponible" class="form-label fw-semibold text-secondary small">Stock Inicial</label>
                            <input asp-for="NuevoRepuesto.StockDisponible" type="number" min="0" class="form-control" placeholder="0" required />
                            <span asp-validation-for="NuevoRepuesto.StockDisponible" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar en Inventario</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Nueva Categoría -->
<div class="modal fade" id="modalNuevaCategoria" tabindex="-1" aria-labelledby="modalNuevaCategoriaLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title fw-bold" id="modalNuevaCategoriaLabel"><i class="bi bi-tags me-2"></i>Agregar Nueva Categoría</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form method="post" asp-controller="Administrador" asp-action="CrearCategoria">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="NuevaCategoria.Nombre" class="form-label fw-semibold text-secondary small">Nombre de la Categoría</label>
                            <input asp-for="NuevaCategoria.Nombre" class="form-control" placeholder="Ej. Procesadores, Placas Base, etc." required />
                            <span asp-validation-for="NuevaCategoria.Nombre" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="NuevaCategoria.Descripcion" class="form-label fw-semibold text-secondary small">Descripción (Opcional)</label>
                            <textarea asp-for="NuevaCategoria.Descripcion" class="form-control" rows="3" placeholder="Breve descripción del tipo de componentes..."></textarea>
                            <span asp-validation-for="NuevaCategoria.Descripcion" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar Categoría</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modales para Editar y Añadir Stock por cada repuesto -->
@if (Model.Repuestos != null)
{
    @foreach (var repuesto in Model.Repuestos)
    {
        <!-- Modal Editar Repuesto -->
        <div class="modal fade" id="modalEditarRepuesto_@repuesto.Id" tabindex="-1" aria-labelledby="modalEditarRepuestoLabel_@repuesto.Id" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-dark text-white">
                        <h5 class="modal-title fw-bold" id="modalEditarRepuestoLabel_@repuesto.Id"><i class="bi bi-pencil-square me-2"></i>Editar Repuesto #@repuesto.Id</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <form method="post" asp-controller="Administrador" asp-action="EditarRepuesto">
                        <input type="hidden" name="Id" value="@repuesto.Id" />
                        <div class="modal-body p-4">
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label class="form-label fw-semibold text-secondary small">Nombre del Repuesto</label>
                                    <input type="text" name="Nombre" value="@repuesto.Nombre" class="form-control" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold text-secondary small">Tipo / Categoría</label>
                                    <select name="Tipo" class="form-select" required>
                                        @foreach (var cat in Model.CategoriasDisponibles)
                                        {
                                            <option value="@cat" selected="@(repuesto.Tipo == cat)">@cat</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold text-secondary small">Precio de Venta ($)</label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input type="number" step="0.01" min="0.01" name="Precio" value="@repuesto.Precio.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" required />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold text-secondary small">Stock Disponible</label>
                                    <input type="number" min="0" name="StockDisponible" value="@repuesto.StockDisponible" class="form-control" required />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer bg-light">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-dark">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Modal Añadir Stock -->
        <div class="modal fade" id="modalAñadirStock_@repuesto.Id" tabindex="-1" aria-labelledby="modalAñadirStockLabel_@repuesto.Id" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title fw-bold" id="modalAñadirStockLabel_@repuesto.Id"><i class="bi bi-plus-slash-minus me-2"></i>Añadir Stock - @repuesto.Nombre</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <form method="post" asp-controller="Administrador" asp-action="AjustarStock">
                        <input type="hidden" name="id" value="@repuesto.Id" />
                        <div class="modal-body p-4">
                            <div class="mb-3">
                                <label class="form-label text-muted small">Stock actual en almacén:</label>
                                <div class="fw-bold fs-5 text-dark">@repuesto.StockDisponible unidades</div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold text-secondary small">Cantidad de unidades a añadir</label>
                                <input type="number" name="cantidad" min="1" value="5" class="form-control" required />
                            </div>
                        </div>
                        <div class="modal-footer bg-light">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Añadir Unidades</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
