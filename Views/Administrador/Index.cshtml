@{
    ViewData["Title"] = "Panel del Administrador";
}

<div class="container py-4">
    <!-- Header del Dashboard -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-1">
                <i class="bi bi-shield-lock-fill text-dark me-2"></i>Panel de Administración
            </h2>
            <p class="text-muted mb-0">Gestión global de usuarios, roles, inventario y supervisión del sistema.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="Administrador" asp-action="Usuarios" class="btn btn-dark shadow-sm">
                <i class="bi bi-people-fill me-1"></i>Gestionar Usuarios
            </a>
            <a asp-controller="Administrador" asp-action="Inventario" class="btn btn-outline-dark shadow-sm">
                <i class="bi bi-boxes me-1"></i>Gestionar Inventario
            </a>
        </div>
    </div>

    <!-- Tarjetas de Métricas Globales -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-primary border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Total Usuarios</span>
                        <h4 class="fw-bold text-dark mb-0 mt-1">18</h4>
                        <span class="text-success small"><i class="bi bi-arrow-up-short"></i>3 Técnicos activos</span>
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-success border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Valor en Almacén</span>
                        <h4 class="fw-bold text-dark mb-0 mt-1">$2,840.00</h4>
                        <span class="text-muted small">5 categorías activas</span>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                        <i class="bi bi-currency-dollar fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-warning border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Reparaciones en Curso</span>
                        <h4 class="fw-bold text-dark mb-0 mt-1">8</h4>
                        <span class="text-warning small"><i class="bi bi-clock-history"></i>En tiempo límite</span>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                        <i class="bi bi-tools fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-danger border-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase">Alertas de Stock</span>
                        <h4 class="fw-bold text-danger mb-0 mt-1">3</h4>
                        <span class="text-danger small">Requiere reabastecimiento</span>
                    </div>
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle text-danger">
                        <i class="bi bi-exclamation-octagon fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Módulos de Administración -->
    <h4 class="fw-bold text-secondary mb-3 fs-5">Módulos Administrativos</h4>
    <div class="row g-4 mb-4">
        
        <!-- Módulo 1: Manejo de Usuarios -->
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm rounded-3 hover-shadow transition-all">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <span class="d-inline-flex align-items-center justify-content-center bg-dark text-white rounded-3 p-3 shadow-sm me-3">
                            <i class="bi bi-person-gear fs-3"></i>
                        </span>
                        <div>
                            <h5 class="fw-bold text-dark mb-1">Manejo de Usuarios y Roles</h5>
                            <span class="badge bg-primary">Administración y Permisos</span>
                        </div>
                    </div>
                    <p class="text-muted small flex-grow-1">
                        Control total de las cuentas del personal técnico y administradores. Creación de credenciales, asignación de roles, activación/bloqueo de cuentas y consulta de información personal.
                    </p>
                    <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="text-muted small"><i class="bi bi-check2-circle text-success me-1"></i>18 Usuarios registrados</span>
                        <a asp-controller="Administrador" asp-action="Usuarios" class="btn btn-dark fw-semibold">
                            Acceder al Módulo <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Módulo 2: Manejo del Inventario -->
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm rounded-3 hover-shadow transition-all">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <span class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-3 p-3 shadow-sm me-3">
                            <i class="bi bi-box-seam-fill fs-3"></i>
                        </span>
                        <div>
                            <h5 class="fw-bold text-dark mb-1">Control General de Inventario</h5>
                            <span class="badge bg-success">Almacén y Precios</span>
                        </div>
                    </div>
                    <p class="text-muted small flex-grow-1">
                        Administración centralizada de repuestos e insumos: altas y bajas de productos, actualización de precios de costo y venta, configuración de stock mínimo, gestión de proveedores y compras.
                    </p>
                    <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="text-muted small"><i class="bi bi-check2-circle text-success me-1"></i>48 Artículos en existencia</span>
                        <a asp-controller="Administrador" asp-action="Inventario" class="btn btn-success fw-semibold">
                            Acceder al Módulo <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Enlace Rápido al Área Técnica para Revisión -->
    <div class="card border-0 bg-light rounded-3 p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <div class="mb-2 mb-md-0">
                <h6 class="fw-bold text-dark mb-1"><i class="bi bi-arrow-left-right me-2 text-primary"></i>¿Deseas revisar los módulos técnicos?</h6>
                <p class="text-muted small mb-0">Puedes navegar al panel operativo del técnico en cualquier momento.</p>
            </div>
            <a asp-controller="Tecnico" asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-tools me-1"></i>Ir a Panel Técnico
            </a>
        </div>
    </div>
</div>
